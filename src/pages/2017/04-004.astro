---
import MySiteLayout from "@layouts/MySiteLayout.astro"
---

<MySiteLayout title="Color Chips" description="Color Chips">
  <body>
    <main>
      <div class="left">
        <span> GD </span>
        <span>USA</span>
      </div>
      <div class="right">
        Graphic Design USA
      </div>
    </main>
  </body>
</MySiteLayout>

<style>
  * {
    box-sizing: border-box;
    --cream: #eae3de;
    --brown: #5b5044;
    --blue: #b1bcc4;
  }
  body {
    background-color: var(--cream);
    font-family: futura-pt-condensed, sans-serif;
    padding: 2rem;
      font-weight: 500;
    font-size: 1.8rem;
  }
  main {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  main div {
    padding: 1rem;
  }
  div.left {
    color: var(--cream);
    background-color: var(--brown);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    line-height: 0.8;
    font-weight: 600;
  }
  div.left span:nth-child(1) {
    font-size: 10rem;
  }
  div.left span:nth-child(2) {
    font-size: 5rem;
    letter-spacing: 10px;
    padding-left: 0.8rem;
  }
  div.right {
    background-color: var(--blue);
    color: var(--brown) ;
    writing-mode: vertical-lr;
    transform: rotate(-180deg);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }
</style>
