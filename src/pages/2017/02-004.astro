---
import MySiteLayout from "@layouts/MySiteLayout.astro"
---

<MySiteLayout title="Der Film" description="02-004">
  <body>
    <main>
      <h1>
        <span>
        der
        </span>
        <span>
        Film
        </span>
</h1>
      <h2>
Kunstegewerbemuseum Zürich<br/>
        Ausstellung
</h2>
        <div class="datesandhours">
          <h3>10.Januar bis 30.April 1960</h3>
          <p>Offen: Montag 14-18, 20-22</p>
          <p>Dienstag-Frietag 10-12, 14-18, 20-22</p>
          <p>Samstag-Sonnttag 10-12, 14-17</p>
        </div>
    </main>
  </body>
</MySiteLayout>
<style>
  * {
    box-sizing: border-box;
    font-weight: 600;

    --grey: #333735;
    --red: #a64941;
    --cream: #a1a48e;
    --white: #e4e1d6;

    -webkit-text-size-adjust: 100%; /* Vendor prefix for widespread mobile browser support */
  -ms-text-size-adjust: 100%;
  text-size-adjust: 100%;

  text-rendering: optimizeLegibility;
  -webkit-font-kerning: normal;
  font-kerning: normal;
  }
  body {
    background-color: var(--grey);
    color: var(--red);
    font-family: Helvetica, sans-serif;
  }
  p {
    margin: 0;
  }
  main{
    display: grid;
    grid-template-columns:minmax(10vw, 40vw) max-content min-content;
    grid-template-rows: 3vh auto 1fr max-content auto 0.5vh;
    height: 97vh;
  }
  h1 {
    display: contents;
    font-size: clamp(5rem, calc(5rem + 25vw), 30rem);
    letter-spacing: -0.04em;
  }
  h1 span:nth-of-type(1) {
    color: var(--cream);
    grid-column: 1/3;
    grid-row: 4/5;
    margin: 0;
    padding: 0;
    margin-left: -0.14em;
  }
  h1 span:nth-of-type(2) {
    color: var(--white);
    grid-column: 2/4;
    grid-row: 4/5;
    margin: 0;
    padding: 0;
margin-left: -0.07em; 
  }
  h2, div, h3 {
    font-size: 1.1rem;
    font-weight: 500;
    display: block;
  }
  h2 {
    grid-column: 2;
    grid-row: 2/3;
  }
  .datesandhours {
    grid-column: 2;
    grid-row: 5/6;
  }
</style>
