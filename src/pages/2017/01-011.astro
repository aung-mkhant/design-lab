---
import { Image } from "astro:assets"
import MySiteLayout from "@layouts/MySiteLayout.astro"
import img1 from "@media/2017/01-011/01.jpg"
import img2 from "@media/2017/01-011/02.jpg"
import img3 from "@media/2017/01-011/03.jpg"
import img4 from "@media/2017/01-011/04.jpg"
import img5 from "@media/2017/01-011/05.jpg"
import img6 from "@media/2017/01-011/06.jpg"
import img7 from "@media/2017/01-011/07.jpg"
import img8 from "@media/2017/01-011/08.jpg"
import img9 from "@media/2017/01-011/09.jpg"
import img10 from "@media/2017/01-011/10.jpg"
import img11 from "@media/2017/01-011/11.jpg"
import img12 from "@media/2017/01-011/12.jpg"
import img13 from "@media/2017/01-011/13.jpg"
import img14 from "@media/2017/01-011/14.jpg"
import img15 from "@media/2017/01-011/15.jpg"
import img16 from "@media/2017/01-011/16.jpg"
import img17 from "@media/2017/01-011/17.jpg"
import img18 from "@media/2017/01-011/18.jpg"
import img19 from "@media/2017/01-011/19.jpg"
import img20 from "@media/2017/01-011/20.jpg"
---

<MySiteLayout title="Mondrian" description="2017-01-011">
  <body>
    <main>
      <ul>
        <li><Image src={img1} alt="white" /></li>
        <li><Image src={img2} alt="white" /></li>
        <li><Image src={img3} alt="yellow" /></li>
        <li><Image src={img4} alt="white" /></li>
        <li><Image src={img5} alt="white" /></li>
        <li><Image src={img6} alt="red" /></li>
        <li><Image src={img7} alt="yellow" /></li>
        <li><Image src={img8} alt="white" /></li>
        <li><Image src={img9} alt="white" /></li>
        <li><Image src={img10} alt="white" /></li>
        <li><Image src={img11} alt="black" /></li>
        <li><Image src={img12} alt="white" /></li>
        <li><Image src={img13} alt="white" /></li>
        <li><Image src={img14} alt="yellow" /></li>
        <li><Image src={img15} alt="white" /></li>
        <li><Image src={img16} alt="blue" /></li>
        <li><Image src={img17} alt="red" /></li>
        <li><Image src={img18} alt="white" /></li>
        <li><Image src={img19} alt="black" /></li>
        <li><Image src={img20} alt="white" /></li>
      </ul>
    </main>
  </body>
</MySiteLayout>
<style>
  * {
    box-sizing: border-box;
  }
  ul {
    display: grid;
    grid-template-columns: 0.6fr 0.8fr 1.5fr 1.5fr 1.2fr 1.2fr 0.3fr;
    grid-template-rows: 0.8fr 1.7fr 2.2fr 0.8fr 0.7fr 0.5fr 0.3fr;
    width: 100%;
    height: 97vh;
    margin: 0;
    padding: 0;
  }
  li:nth-child(1) {
    grid-column: 1/3;
    grid-row: 1/2;
  }
  li:nth-child(2) {
    grid-column: 3/5;
    grid-row: 1/2;
  }
  li:nth-child(3) {
    grid-column: 5/7;
    grid-row: 1/3;
  }
</style>
