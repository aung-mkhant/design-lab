---
interface Props {
  title: string
  description: string
}
import Head from "../components/Head.astro"
import Footer from "../components/Footer.astro"
const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head title={title} />
  </head>
  <slot />
  <Footer />
</html>
